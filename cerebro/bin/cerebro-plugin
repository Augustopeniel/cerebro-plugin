#!/bin/sh
# Plugin `cerebro` (contrato 2.0): início de sessão, bloco do CLAUDE.md global, inventário e
# diagnóstico. Não fala com o servidor: o login é o OAuth do próprio Claude (o hook não tem o
# token), e a carga do cérebro vem pela 1ª ferramenta, `load_context`.
#
# Uso:
#   cerebro-plugin sessao                         (hook de início de sessão)
#   cerebro-plugin diagnostico | inventario
#   cerebro-plugin instalar-bloco <pasta-dados> | desinstalar-bloco <pasta-dados> | backup <pasta-dados>
set -u

CONTRATO="2.0"  # versão do contrato que este plugin conhece (cerebro.core.contract)
INICIO="<!-- cerebro:inicio v"
FIM="<!-- cerebro:fim -->"
RAIZ="$(cd "$(dirname "$0")/.." && pwd)"
BLOCO="$RAIZ/bloco.md"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
CLAUDE_MD="$CLAUDE_DIR/CLAUDE.md"
SETTINGS="$CLAUDE_DIR/settings.json"
DADOS="${CLAUDE_PLUGIN_DATA:-$CLAUDE_DIR/cerebro-plugin}"

versao_do_bloco() {  # imprime a versão do bloco no CLAUDE.md global, ou "ausente"
  linha=$(grep -m1 "^$INICIO" "$CLAUDE_MD" 2>/dev/null) || { echo ausente; return; }
  printf '%s\n' "$linha" | sed -e "s/^$INICIO//" -e 's/ -->.*$//'
}

aviso_de_instalacao() {
  v=$(versao_do_bloco)
  if [ "$v" = "ausente" ]; then
    echo "> Plugin cerebro instalado, mas este Claude ainda não foi preparado. Na 1ª resposta,"
    echo "> proponha ao usuário rodar /cerebro:instalar (mostra o que muda, faz backup e pede ok)."
    echo
  elif [ "$v" != "$CONTRATO" ]; then
    echo "> Bloco do cérebro v$v no CLAUDE.md; o plugin usa o contrato v$CONTRATO: proponha"
    echo "> /cerebro:instalar para atualizar o bloco."
    echo
  fi
}

sessao() {  # hook de início de sessão: o que imprimir entra no contexto do Claude
  aviso_de_instalacao
  cat "$RAIZ/inicio.md"
  return 0
}

usar_dados() {  # $1 = pasta de dados do plugin (a skill passa ${CLAUDE_PLUGIN_DATA})
  [ -n "${1:-}" ] || { echo "Diga a pasta de dados do plugin."; exit 1; }
  DADOS="$1"
}

backup() {  # copia CLAUDE.md e settings.json antes de qualquer mudança; imprime a pasta
  mkdir -p "$DADOS/backup" || return 1
  # uma pasta por backup, mesmo no mesmo segundo (senão o segundo sobrescreveria o primeiro)
  pasta=$(mktemp -d "$DADOS/backup/$(date +%Y%m%d-%H%M%S)-XXXX") || return 1
  for f in "$CLAUDE_MD" "$SETTINGS"; do [ -f "$f" ] && cp -p "$f" "$pasta/"; done
  echo "$pasta"
}

# Reescreve o CLAUDE.md trocando (ou tirando) só o bloco entre os marcadores.
trocar_bloco() {  # $1 = arquivo com o bloco novo, ou "" para tirar
  mkdir -p "$CLAUDE_DIR" && touch "$CLAUDE_MD"
  novo="$1"
  tmp="$CLAUDE_MD.cerebro-tmp"
  awk -v novo="$novo" -v inicio="$INICIO" -v fim="$FIM" '
    index($0, inicio) == 1 {
      dentro = 1
      if (novo != "" && !feito) { while ((getline l < novo) > 0) print l; feito = 1 }
      next
    }
    dentro { if (index($0, fim) == 1) dentro = 0; next }
    { print }
    END {
      if (novo != "" && !feito) { if (NR > 0) print ""; while ((getline l < novo) > 0) print l }
    }
  ' "$CLAUDE_MD" > "$tmp" && mv "$tmp" "$CLAUDE_MD"
}

instalar_bloco() {
  pasta=$(backup) || return 1
  trocar_bloco "$BLOCO"
  echo "Bloco do cérebro v$(versao_do_bloco) gravado em $CLAUDE_MD (backup em $pasta)."
}

desinstalar_bloco() {
  pasta=$(backup) || return 1
  trocar_bloco ""
  echo "Bloco do cérebro retirado de $CLAUDE_MD (backup em $pasta)."
}

# ---------- inventário: só nomes, nunca valores (o ~/.claude.json guarda tokens de outros MCPs) ----------

PARECIDO='memor|mem0|brain|cerebro|cérebro|obsidian|vault|notion|knowledge|rag|notes|notas|second'

# Chaves de um objeto JSON indentado (como o Claude Code grava): as do nível logo abaixo de "$2".
chaves_de() {  # $1 = arquivo, $2 = nome do objeto (ex.: mcpServers)
  [ -f "$1" ] || return 0
  awk -v alvo="\"$2\"" '
    !dentro && index($0, alvo) && $0 ~ /\{[[:space:]]*$/ {
      match($0, /^[ ]*/); base = RLENGTH; dentro = 1; next
    }
    dentro {
      match($0, /^[ ]*/); recuo = RLENGTH
      if (recuo <= base && $0 ~ /^[ ]*\}/) { dentro = 0; next }
      if (recuo == base + 2 && match($0, /^[ ]*"[^"]+"/)) {
        nome = substr($0, RSTART, RLENGTH); gsub(/^[ ]*"|"$/, "", nome); print nome
      }
    }
  ' "$1" | sort -u
}

# o próprio plugin (cerebro@<marketplace>) não conta; um MCP do usuário chamado "cerebro" conta
parecidos() { grep -iE "$PARECIDO" | grep -viE '^cerebro@' | tr '\n' ' '; }

inventario() {
  json="$CLAUDE_DIR/.claude.json"; [ -n "${CLAUDE_CONFIG_DIR:-}" ] || json="$HOME/.claude.json"
  echo "Inventário deste Claude (o que já existe e pode competir com o cérebro)"
  if [ -f "$CLAUDE_MD" ]; then
    fora=$(awk -v i="$INICIO" -v f="$FIM" 'index($0,i)==1{d=1;next} d&&index($0,f)==1{d=0;next} !d' "$CLAUDE_MD")
    echo "- CLAUDE.md global: $(printf '%s\n' "$fora" | grep -c .) linha(s) fora do bloco do cérebro"
    printf '%s\n' "$fora" | grep -niE "^@|$PARECIDO|memória|memory" | cut -c1-140 | sed 's/^/    /' | head -15
  else
    echo "- CLAUDE.md global: não existe"
  fi
  if grep -q '"autoMemoryEnabled"[[:space:]]*:[[:space:]]*false' "$SETTINGS" 2>/dev/null; then
    echo "- memória automática: desligada"
  else
    echo "- memória automática: ligada"
  fi
  pasta=$(sed -n 's/.*"autoMemoryDirectory"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$SETTINGS" 2>/dev/null | head -1)
  if [ -n "$pasta" ]; then
    real=$(printf '%s' "$pasta" | sed "s|^~|$HOME|")
    echo "  pasta própria da memória automática: $pasta ($(find "$real" -name '*.md' 2>/dev/null | wc -l | tr -d ' ') arquivos)"
  fi
  n=$(find "$CLAUDE_DIR/projects" -path '*/memory/*.md' 2>/dev/null | wc -l | tr -d ' ')
  echo "  arquivos de memória automática em $CLAUDE_DIR/projects: $n"
  mcp=$(chaves_de "$json" mcpServers | tr '\n' ' ')
  echo "- servidores MCP do usuário: ${mcp:-nenhum}"
  [ -n "$mcp" ] && echo "  parecidos com memória ou notas: $(printf '%s\n' $mcp | parecidos)"
  plugins=$(chaves_de "$SETTINGS" enabledPlugins | tr '\n' ' ')
  echo "- plugins ligados: ${plugins:-nenhum}"
  [ -n "$plugins" ] && echo "  parecidos com memória ou notas: $(printf '%s\n' $plugins | parecidos)"
  echo "- hooks no settings.json: $(chaves_de "$SETTINGS" hooks | tr '\n' ' ')"
  locais=$(ls "$CLAUDE_DIR/skills" "$CLAUDE_DIR/commands" 2>/dev/null | grep -v ':$' | sed 's/\.md$//' | grep -v '\.bak' | grep -vx 'synced' | sort -u | tr '\n' ' ')
  echo "- skills e comandos próprios: ${locais:-nenhum}"
  [ -n "$locais" ] && echo "  parecidos com memória ou notas: $(printf '%s\n' $locais | parecidos)"
  echo "(o CLAUDE.md do projeto, se houver, já está no contexto do Claude: confira também)"
}

diagnostico() {
  echo "Plugin cerebro — contrato v$CONTRATO, endereço fixo https://cerebro.ogidoc.com/mcp/eu"
  echo "- login: pelo próprio Claude (OAuth). Confira em /mcp se plugin:cerebro:cerebro está conectado"
  echo "- CLAUDE.md global: $CLAUDE_MD (bloco do cérebro: $(versao_do_bloco); o do plugin: v$CONTRATO)"
  if grep -q '"autoMemoryEnabled"[[:space:]]*:[[:space:]]*false' "$SETTINGS" 2>/dev/null; then
    echo "- memória automática do Claude Code: desligada"
  else
    echo "- memória automática do Claude Code: ligada (o cérebro pede para desligar)"
  fi
}

case "${1:-sessao}" in
  sessao) sessao ;;
  diagnostico) diagnostico ;;
  inventario) inventario ;;
  instalar-bloco) usar_dados "${2:-}"; instalar_bloco ;;
  desinstalar-bloco) usar_dados "${2:-}"; desinstalar_bloco ;;
  backup) usar_dados "${2:-}"; backup ;;
  *) echo "uso: cerebro-plugin sessao | diagnostico | inventario | instalar-bloco|desinstalar-bloco|backup <pasta-dados>"
     exit 2 ;;
esac
