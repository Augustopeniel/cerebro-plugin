#!/bin/sh
# Plugin `cerebro`: entrada do lançador nativo no macOS e no Linux (no Windows, o Claude Code e o
# PowerShell acham sozinhos o bin/cerebro-plugin.exe). O lançador não depende de nada instalado:
# veja launcher/main.go.
RAIZ="$(cd "$(dirname "$0")/.." && pwd)"
case "$(uname -s)" in
  Darwin) so=darwin ;;
  Linux) so=linux ;;
  MINGW*|MSYS*|CYGWIN*) exec "$RAIZ/bin/cerebro-plugin.exe" "$@" ;;
  *) echo "cerebro-plugin: sistema sem suporte: $(uname -s)" >&2; exit 1 ;;
esac
case "$(uname -m)" in
  arm64|aarch64) arq=arm64 ;;
  x86_64|amd64) arq=amd64 ;;
  *) echo "cerebro-plugin: processador sem suporte: $(uname -m)" >&2; exit 1 ;;
esac
exec "$RAIZ/nativo/cerebro-plugin-$so-$arq" "$@"
