{
  "mcpServers": {
    "cerebro": {
      "type": "http",
      "url": "https://cerebro.ogidoc.com/mcp/eu",
      "headers": {
        "X-Cerebro-Plugin": "2.2"
      }
    },
    "cofre": {
      "type": "stdio",
      "command": "${CLAUDE_PLUGIN_ROOT}/bin/cerebro-plugin",
      "args": [
        "cofre",
        "mcp"
      ],
      "env": {
        "CEREBRO_URL": "https://cerebro.ogidoc.com",
        "CLAUDE_PLUGIN_DATA": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
