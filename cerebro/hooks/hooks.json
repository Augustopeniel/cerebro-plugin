{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/cerebro-plugin\" sessao", "timeout": 30 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/bash_guard.py\"", "timeout": 15 }
        ]
      }
    ]
  }
}
